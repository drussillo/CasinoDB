<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CasinoApp.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CasinoApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Search controls -->
            <RowDefinition Height="*" />
            <!-- Search results -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Search"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Grid.Row="1"
                           Text="Search records across casino tables." />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="32,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Table selection: existing binding and event are unchanged. -->
            <ComboBox
    x:Name="TableBox"
    Header="Table"
    Width="160"
    HorizontalAlignment="Left"
    MaxDropDownHeight="250"
    ItemsSource="{x:Bind Tables}"
    SelectionChanged="TableBox_SelectionChanged">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                Text="{Binding TableName}"
                Width="140"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>



            </ComboBox>

            <!-- Column selection: existing display binding is unchanged. -->
            <ComboBox Grid.Column="1"
                      x:Name="ColumnBox"
                      Header="Column"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="250"
                      DisplayMemberPath="ColumnName" />

            <TextBox Grid.Column="2"
                     x:Name="SearchBox"
                     Header="Search term"
                     PlaceholderText="Input Search Term"
                     HorizontalAlignment="Stretch" />

            <Button Grid.Column="3"
                    x:Name="SearchButton"
                    Content="Search"
                    FontWeight="SemiBold"
                    Click="OnClick1"
                    ClickMode="Release"
                    VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="2" Padding="16,8,16,16">
            <ListView x:Name="ResultsListView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SearchResultItem">
                        <StackPanel Padding="8,8">
                            <TextBlock Text="{x:Bind PrimaryText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind SecondaryText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
