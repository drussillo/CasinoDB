<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CasinoApp.Pages.PitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CasinoApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- header -->
            <RowDefinition Height="Auto" />
            <!-- labels -->
            <RowDefinition Height="*" />
            <!-- list -->
            <RowDefinition Height="Auto" />
            <!-- buttons -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Pits" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Grid.Row="1" Text="All current casino pits and their assigned bosses!" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Pit Name" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="Pit Boss" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="Floor" FontWeight="Bold" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Padding="16">
                <ListView ItemsSource="{x:Bind Pits}" x:Name="ListViewPits" SelectionChanged="ListViewPits_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PitView">
                            <Grid Padding="12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind PitBossName}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Floor}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="16">
            <Button FontWeight="SemiBold" Content="Add" x:Name="AddButton" Click="Add_Click" />
            <Button FontWeight="SemiBold" Content="Edit" IsEnabled="False" x:Name="EditButton" Click="Edit_Click" />
            <Button FontWeight="SemiBold" Content="Delete" IsEnabled="False" x:Name="DeleteButton" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</Page>
