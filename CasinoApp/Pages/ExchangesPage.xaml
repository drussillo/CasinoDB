<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CasinoApp.Pages.ExchangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CasinoApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- header -->
            <RowDefinition Height="Auto" />
            <!-- labels -->
            <RowDefinition Height="*" />
            <!-- list -->
            <RowDefinition Height="Auto" />
            <!-- buttons -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Exchanges" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Grid.Row="1" Text="All recorded chip and cash exchanges at the casino!" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Exchange ID" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="Gambler ID" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="Gambler Name" FontWeight="Bold" />
            <TextBlock Grid.Column="3" Text="Amount" FontWeight="Bold" />
            <TextBlock Grid.Column="4" Text="Chips Exchange" FontWeight="Bold" />
            <TextBlock Grid.Column="5" Text="Date" FontWeight="Bold" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            
            <StackPanel Padding="16">
                <ListView ItemsSource="{x:Bind Exchanges}" x:Name="ListViewExchanges" SelectionChanged="ListViewExchanges_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ExchangeView">
                            <Grid Padding="12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind ExchangeID}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind GamblerID}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind GamblerName}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind AmountDisplay}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ToChipsDisplay}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind TimeDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="16">
            <Button FontWeight="SemiBold" Content="Add" x:Name="AddButton" Click="Add_Click" />
            <Button FontWeight="SemiBold" Content="Edit" IsEnabled="False" x:Name="EditButton" Click="Edit_Click" />
            <Button FontWeight="SemiBold" Content="Delete" IsEnabled="False" x:Name="DeleteButton" Click="Delete_Click" />
            <Button FontWeight="SemiBold" Content="Start Demo" x:Name="Demo" Click="Demo_Click" />
        </StackPanel>
    </Grid>
</Page>
